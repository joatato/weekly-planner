# Copiar este archivo a .env.local y completar con los valores de
# Firebase Console → Configuración del proyecto → Tus apps → App web.
# Estos valores no son secretos (viajan en el bundle del cliente);
# la seguridad real va por las reglas de Firestore/Auth.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
